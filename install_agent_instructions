#!/usr/bin/env bash

set -euo pipefail
umask 077

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SOURCE_FILE="$SCRIPT_DIR/AGENTS.md"
START_MARKER="<!-- dotfiles:agent-instructions:start -->"
END_MARKER="<!-- dotfiles:agent-instructions:end -->"
temp_file=""

trap 'if [[ -n "$temp_file" ]]; then rm -f -- "$temp_file"; fi' EXIT

fail() {
	printf 'ERROR: %s\n' "$*" >&2
	exit 1
}

[[ -s "$SOURCE_FILE" ]] || fail "Shared instructions are missing or empty: $SOURCE_FILE"

install_instructions() {
	local destination="$1" directory existing
	directory="$(dirname -- "$destination")"
	existing=/dev/null

	if [[ -L "$destination" && ! -e "$destination" ]]; then
		fail "Instruction path is a broken symlink: $destination"
	fi
	if [[ -e "$destination" ]]; then
		[[ -f "$destination" && -r "$destination" && -w "$destination" ]] ||
			fail "Instruction path must be a readable, writable file: $destination"
		if [[ "$destination" -ef "$SOURCE_FILE" ]]; then
			printf 'Already using shared instructions: %s\n' "$destination"
			return
		fi
		existing="$destination"
	fi

	mkdir -p -- "$directory"
	temp_file="$(mktemp "$directory/.dotfiles-agent-instructions.XXXXXX")"
	if ! awk -v start="$START_MARKER" -v end="$END_MARKER" '
		FILENAME == ARGV[1] {
			instructions = instructions $0 ORS
			next
		}
		$0 == start {
			if (inside || seen) { invalid = 1; exit }
			inside = 1
			seen = 1
			next
		}
		$0 == end {
			if (!inside) { invalid = 1; exit }
			inside = 0
			next
		}
		!inside { existing = existing $0 ORS }
		END {
			if (invalid || inside) exit 1
			print start
			printf "%s", instructions
			print end
			printf "%s", existing
		}
	' "$SOURCE_FILE" "$existing" > "$temp_file"; then
		fail "Cannot update $destination; check file access and managed block markers."
	fi

	if [[ ! -e "$destination" ]] || ! cmp -s "$temp_file" "$destination"; then
		# Write through existing symlinks and retain existing file permissions.
		cat "$temp_file" > "$destination"
	fi
	rm -f -- "$temp_file"
	temp_file=""
	printf 'Installed shared instructions: %s\n' "$destination"
}

copilot_home="${COPILOT_HOME:-$HOME/.copilot}"
codex_home="${CODEX_HOME:-$HOME/.codex}"
claude_home="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

install_instructions "$copilot_home/copilot-instructions.md"
install_instructions "$codex_home/AGENTS.md"

# Codex reads a nonblank global override instead of AGENTS.md.
override="$codex_home/AGENTS.override.md"
if [[ -e "$override" || -L "$override" ]]; then
	[[ -f "$override" && -r "$override" ]] || fail "Cannot read Codex override: $override"
	if grep -q '[^[:space:]]' "$override"; then
		install_instructions "$override"
	else
		status=$?
		[[ "$status" -eq 1 ]] || fail "Cannot read Codex override: $override"
	fi
fi

install_instructions "$claude_home/CLAUDE.md"
