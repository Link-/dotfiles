#!/usr/bin/env bash

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)" || exit 1
WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-install.XXXXXX")" || exit 1
trap 'rm -r -- "$WORK_DIR"' EXIT

failures=0
BREW=""
OMZ_DIR="${ZSH:-$HOME/.oh-my-zsh}"
COMPLETIONS_DIR="$HOME/.zsh/completions"

info() { printf 'INFO: %s\n' "$*"; }
error() { printf 'ERROR: %s\n' "$*" >&2; }
die() { error "$*"; exit 1; }

# Each step stops on its first error; the parent keeps running other steps.
run_step() {
	local label="$1" status
	shift
	info "$label"
	(
		set -e
		"$@"
	)
	status=$?
	if [[ "$status" -ne 0 ]]; then
		error "$label failed (status $status)"
		failures=$((failures + 1))
	fi
	return "$status"
}

skip_step() {
	error "$1 skipped: $2"
	failures=$((failures + 1))
}

require_command() {
	command -v "$1" >/dev/null || die "Required command not found: $1"
}

find_brew() {
	local candidate
	if command -v brew; then
		return
	fi
	for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
		if [[ -x "$candidate" ]]; then
			printf '%s\n' "$candidate"
			return
		fi
	done
	return 1
}

ensure_homebrew() {
	local executable
	if executable="$(find_brew)"; then
		"$executable" --version >/dev/null
		info "Homebrew already installed"
		return
	fi
	curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o "$WORK_DIR/homebrew.sh"
	NONINTERACTIVE=1 /bin/bash "$WORK_DIR/homebrew.sh"
	find_brew >/dev/null || die "Homebrew installed but its executable could not be found"
}

install_package() {
	HOMEBREW_NO_AUTO_UPDATE=1 "$BREW" install "$1"
}

configure_fzf() {
	local prefix
	prefix="$("$BREW" --prefix)"
	"$prefix/opt/fzf/install" --key-bindings --completion --no-update-rc
}

clone_repository() {
	local url="$1" destination="$2"
	require_command git
	if [[ -e "$destination" ]]; then
		[[ -e "$destination/.git" ]] || die "Not replacing an existing non-Git directory: $destination"
		git -C "$destination" rev-parse --verify HEAD >/dev/null
		info "Already installed: $destination"
		return
	fi
	mkdir -p -- "$(dirname -- "$destination")"
	git clone --depth=1 "$url" "$destination"
}

install_pathogen() {
	mkdir -p "$HOME/.vim/autoload" "$HOME/.vim/bundle"
	curl -fsSL https://raw.githubusercontent.com/tpope/vim-pathogen/master/autoload/pathogen.vim -o "$WORK_DIR/pathogen.vim"
	cp "$WORK_DIR/pathogen.vim" "$HOME/.vim/autoload/pathogen.vim"
}

install_completion() {
	local tool="$1"
	require_command "$tool"
	mkdir -p -- "$COMPLETIONS_DIR"
	"$tool" completion zsh > "$WORK_DIR/_$tool"
	cp "$WORK_DIR/_$tool" "$COMPLETIONS_DIR/_$tool"
}

install_agent_instructions() {
	local destination="$1" existing=/dev/null
	local source="$SCRIPT_DIR/AGENTS.md" temporary="$WORK_DIR/agent-instructions"
	umask 077
	[[ -s "$source" ]] || die "Shared instructions are missing or empty: $source"
	if [[ -L "$destination" && ! -e "$destination" ]]; then
		die "Instruction path is a broken symlink: $destination"
	fi
	if [[ -e "$destination" ]]; then
		[[ -f "$destination" && -r "$destination" && -w "$destination" ]] ||
			die "Instruction path must be a readable, writable file: $destination"
		if [[ "$destination" -ef "$source" ]]; then
			info "Already using shared instructions: $destination"
			return
		fi
		existing="$destination"
	fi
	mkdir -p -- "$(dirname -- "$destination")"
	awk '
		BEGIN {
			start = "<!-- dotfiles:agent-instructions:start -->"
			end = "<!-- dotfiles:agent-instructions:end -->"
		}
		FILENAME == ARGV[1] { instructions = instructions $0 ORS; next }
		$0 == start {
			if (inside || seen) { invalid = 1; exit }
			inside = seen = 1
			next
		}
		$0 == end {
			if (!inside) { invalid = 1; exit }
			inside = 0
			next
		}
		!inside { existing = existing $0 ORS }
		END {
			if (invalid || inside) {
				print "ERROR: Invalid managed agent instruction markers" > "/dev/stderr"
				exit 1
			}
			print start
			printf "%s", instructions
			print end
			printf "%s", existing
		}
	' "$source" "$existing" > "$temporary"
	if [[ ! -e "$destination" ]] || ! cmp -s "$temporary" "$destination"; then
		# Keep existing file permissions and write through existing symlinks.
		cat "$temporary" > "$destination"
	fi
}

install_codex_override() {
	local override="${CODEX_HOME:-$HOME/.codex}/AGENTS.override.md" status
	if [[ ! -e "$override" && ! -L "$override" ]]; then
		return
	fi
	[[ -f "$override" && -r "$override" ]] || die "Cannot read Codex override: $override"
	if grep -q '[^[:space:]]' "$override"; then
		install_agent_instructions "$override"
	else
		status=$?
		[[ "$status" -eq 1 ]] || die "Cannot read Codex override: $override"
	fi
}

merge_zshrc() {
	local destination="$HOME/.zshrc" existing=/dev/null backup prefix=""
	require_command zsh
	if [[ -L "$destination" && ! -e "$destination" ]]; then
		die "Not replacing a broken .zshrc symlink"
	fi
	if [[ -e "$destination" ]]; then
		[[ -f "$destination" && -r "$destination" && -w "$destination" ]] ||
			die ".zshrc must be a readable, writable file"
		[[ ! "$destination" -ef "$SCRIPT_DIR/.zshrc" ]] ||
			die "Refusing to rewrite the repository's .zshrc through a link"
		existing="$destination"
	fi

	# Remove only our previous block; keep all user code in its original order.
	awk '
		$0 == "# dotfiles:defaults:start" {
			if (inside || seen) { invalid = 1; exit }
			inside = seen = 1
			next
		}
		$0 == "# dotfiles:defaults:end" {
			if (!inside) { invalid = 1; exit }
			inside = 0
			next
		}
		!inside { print }
		END {
			if (invalid || inside) {
				print "ERROR: Invalid managed .zshrc markers" > "/dev/stderr"
				exit 1
			}
		}
	' "$existing" > "$WORK_DIR/zshrc-existing"

	if [[ -n "$BREW" ]]; then
		prefix="$("$BREW" --prefix)"
	fi
	# These variables must expand when zsh starts, not during installation.
	# shellcheck disable=SC2016
	{
		cat "$SCRIPT_DIR/.zshrc"
		printf '\n'
		printf '[[ ! -f "$HOME/powerlevel10k/powerlevel10k.zsh-theme" ]] || source "$HOME/powerlevel10k/powerlevel10k.zsh-theme"\n'
		printf '[[ ! -f "$HOME/.p10k.zsh" ]] || source "$HOME/.p10k.zsh"\n'
		printf '[[ ! -f "$HOME/.fzf.zsh" ]] || source "$HOME/.fzf.zsh"\n'
		if [[ -n "$prefix" ]]; then
			printf 'export PATH="$PATH":%q:"$HOME/.local/bin"\n' "$prefix/bin"
		else
			printf 'export PATH="$PATH:$HOME/.local/bin"\n'
		fi
		printf 'fpath=("$HOME/.zsh/completions" $fpath)\nautoload -Uz compinit\ncompinit\n'
		printf 'alias dotfiles=%q\n' "cd -- $(printf '%q' "$SCRIPT_DIR")"
		printf "alias k='kubectl'\nalias ll='eza -la -g'\nalias l='eza -la -g'\n"
	} > "$WORK_DIR/zshrc-defaults"

	# Recognize common declarations, not arbitrary shell program equivalence.
	awk '
		function trim(text) {
			sub(/^[ \t]+/, "", text); sub(/[ \t]+$/, "", text)
			return text
		}
		function source_key(text) {
			if (trim(text) ~ /^#/) return ""
			if (!match(text, /(^|[ \t;&|])(source|\.)[ \t]+/)) return ""
			text = substr(text, RSTART + RLENGTH)
			gsub(/["\047]/, "", text)
			sub(/[ \t]+#.*/, "", text)
			text = trim(text)
			sub(/[ \t]*;$/, "", text)
			gsub(/\$\{HOME\}/, "$HOME", text)
			gsub(/\$\{ZSH\}/, "$ZSH", text)
			sub(/^~/, "$HOME", text)
			return "source:" text
		}
		function key(line, text) {
			text = trim(line)
			if (text ~ /^#/) return ""
			sub(/^(export|typeset|declare|readonly)[ \t]+(-[a-zA-Z]+[ \t]+)*/, "", text)
			if (match(text, /^[a-zA-Z_][a-zA-Z_0-9]*\+?=/)) {
				text = substr(text, 1, RLENGTH)
				sub(/\+?=$/, "", text)
				if (text == "path") text = "PATH"
				if (text == "fpath") text = "FPATH"
				return "variable:" text
			}
			if (text ~ /^alias[ \t]+[a-zA-Z_][a-zA-Z_0-9-]*=/) {
				sub(/^alias[ \t]+/, "", text); sub(/=.*/, "", text)
				return "alias:" text
			}
			return source_key(text)
		}
		FILENAME == ARGV[1] {
			existing = existing $0 ORS
			# Reserve declared keys even in guards rather than risk overriding them.
			k = key($0)
			if (k != "") keys[k] = 1
			text = trim($0)
			if (text !~ /^#/ && text != "") lines[text] = 1
			next
		}
		{
			line = $0
			k = key(line)
			chunk = line ORS
			# Keep multiline arrays and the instant-prompt guard intact.
			if (line ~ /^[ \t]*(export[ \t]+)?[a-zA-Z_][a-zA-Z_0-9]*=\([ \t]*$/) {
				while ((getline line) > 0) {
					chunk = chunk line ORS
					if (line ~ /^[ \t]*\)[ \t]*(#.*)?$/) break
				}
			} else if (line ~ /^if .*p10k-instant-prompt/) {
				while ((getline line) > 0) {
					chunk = chunk line ORS
					if (source_key(line) != "") k = source_key(line)
					if (line ~ /^fi([ \t;]|$)/) break
				}
			}
			if (k != "") {
				if (keys[k]) next
				keys[k] = 1
			} else if (trim($0) in lines || chunk in chunks) next
			chunks[chunk] = 1
			defaults = defaults chunk
		}
		END {
			printf "%s", existing
			print "# dotfiles:defaults:start"
			printf "%s", defaults
			print "# dotfiles:defaults:end"
		}
	' "$WORK_DIR/zshrc-existing" "$WORK_DIR/zshrc-defaults" > "$WORK_DIR/zshrc-merged"

	zsh -n "$WORK_DIR/zshrc-merged"
	if [[ -e "$destination" ]] && cmp -s "$WORK_DIR/zshrc-merged" "$destination"; then
		info ".zshrc already up to date"
		return
	fi
	if [[ -e "$destination" ]]; then
		backup="$(mktemp "$HOME/.zshrc.backup.XXXXXX")"
		cp -pL "$destination" "$backup"
		info "Backed up .zshrc to $backup"
	fi
	cat "$WORK_DIR/zshrc-merged" > "$destination"
}

run_step "Copilot CLI instructions" install_agent_instructions "${COPILOT_HOME:-$HOME/.copilot}/copilot-instructions.md"
run_step "Codex instructions" install_agent_instructions "${CODEX_HOME:-$HOME/.codex}/AGENTS.md"
run_step "Codex global override" install_codex_override
run_step "Claude Code instructions" install_agent_instructions "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/CLAUDE.md"

run_step "Homebrew" ensure_homebrew
brew_status=$?
if [[ "$brew_status" -eq 0 ]]; then
	BREW="$(find_brew)"
	PATH="$(dirname -- "$BREW"):$PATH"
	export PATH
	for package in fzf bat tree jq mycli helm zoxide gh eza goenv copilot-cli; do
		run_step "Installing $package" install_package "$package"
		package_status=$?
		case "$package" in
			fzf) fzf_status=$package_status ;;
			helm) helm_status=$package_status ;;
		esac
	done
	if [[ "$fzf_status" -eq 0 ]]; then
		run_step "Configuring fzf" configure_fzf
	else
		skip_step "Configuring fzf" "fzf installation failed"
	fi
else
	skip_step "Homebrew packages and fzf configuration" "Homebrew is unavailable"
	helm_status=1
fi

run_step "Installing lnav" sudo install -m 755 "$SCRIPT_DIR/tools/lnav" /usr/local/bin/lnav
run_step "Installing datefmt" sudo install -m 755 "$SCRIPT_DIR/tools/date" /usr/local/bin/datefmt
run_step "Linking start_ssh_agent" sudo ln -sf "$SCRIPT_DIR/start_ssh_agent.sh" /usr/local/bin/start_ssh_agent
run_step "Vim pathogen" install_pathogen
run_step "Vim apprentice theme" clone_repository https://github.com/romainl/Apprentice.git "$HOME/.vim/bundle/apprentice"
run_step "Vim configuration" cp "$SCRIPT_DIR/.vimrc" "$HOME/.vimrc"
run_step "tmux configuration" cp "$SCRIPT_DIR/.tmux.conf" "$HOME/.tmux.conf"
run_step "Git configuration" cp "$SCRIPT_DIR/.gitconfig" "$HOME/.gitconfig"

if command -v zsh >/dev/null; then
	info "zsh already installed"
elif [[ "$brew_status" -eq 0 ]]; then
	run_step "Installing zsh" install_package zsh
else
	skip_step "Installing zsh" "Homebrew is unavailable"
fi
if command -v zsh >/dev/null; then
	run_step "Oh My Zsh" clone_repository https://github.com/ohmyzsh/ohmyzsh.git "$OMZ_DIR"
	omz_status=$?
else
	skip_step "Oh My Zsh" "zsh is unavailable"
	omz_status=1
fi

run_step "Powerlevel10k theme" clone_repository https://github.com/romkatv/powerlevel10k.git "$HOME/powerlevel10k"
run_step "Powerlevel10k configuration" cp "$SCRIPT_DIR/.p10k.zsh" "$HOME/.p10k.zsh"
if [[ "$omz_status" -eq 0 ]]; then
	run_step "zsh autosuggestions" clone_repository https://github.com/zsh-users/zsh-autosuggestions.git "${ZSH_CUSTOM:-$OMZ_DIR/custom}/plugins/zsh-autosuggestions"
else
	skip_step "zsh autosuggestions" "Oh My Zsh installation failed"
fi
run_step "kubectl completions" install_completion kubectl
if [[ "$helm_status" -eq 0 ]]; then
	run_step "Helm completions" install_completion helm
else
	skip_step "Helm completions" "Helm installation failed or Homebrew is unavailable"
fi
run_step "tmux plugin manager" clone_repository https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
run_step "Merging .zshrc" merge_zshrc

if [[ "$failures" -gt 0 ]]; then
	error "Installation finished with $failures failed or skipped steps"
	exit 1
fi
info "Installation finished successfully"
