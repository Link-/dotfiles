#!/usr/bin/env bash
#
# Set up this machine from the dotfiles repo.
# Every step runs even if an earlier one failed. Failed steps are listed at
# the end and the script exits with status 1.

cd "$(dirname "$0")" || exit 1
DOTFILES="$PWD"
failed_steps=()

info() { printf '\033[34m[+]\033[0m %s\n' "$*"; }
error() { printf '\033[31m[!] ERROR:\033[0m %s\n' "$*" >&2; }

# Run one step. On failure, print an error, remember it and carry on.
step() {
	local name="$1"
	shift
	info "$name"
	if ! "$@"; then
		error "$name failed"
		failed_steps+=("$name")
	fi
}

backup() {
	cp "$1" "$1.backup.$(date +%Y%m%d%H%M%S)"
}

# Copy a repo file into place. A different existing file is backed up first.
copy_file() {
	local source="$1" target="$2"
	if [[ -e "$target" ]] && ! cmp -s "$source" "$target"; then
		backup "$target" || return 1
	fi
	mkdir -p "$(dirname "$target")" && cp "$source" "$target"
}

# Clone a Git repository, unless it is already there.
clone() {
	[[ -d "$2" ]] && return 0
	git clone --depth=1 "$1" "$2"
}

brew_install() {
	HOMEBREW_NO_AUTO_UPDATE=1 brew install "$1"
}

# Homebrew can be installed but not yet on PATH.
load_brew() {
	local brew
	for brew in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
		[[ -x "$brew" ]] && eval "$("$brew" shellenv)" && return 0
	done
	return 1
}

install_homebrew() {
	command -v brew >/dev/null && return 0
	load_brew && return 0
	NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" &&
		load_brew
}

install_zsh() {
	command -v zsh >/dev/null || brew_install zsh
}

configure_fzf() {
	"$(brew --prefix)/opt/fzf/install" --key-bindings --completion --no-update-rc
}

install_pathogen() {
	mkdir -p "$HOME/.vim/autoload" "$HOME/.vim/bundle" &&
		curl -fsSLo "$HOME/.vim/autoload/pathogen.vim" https://raw.githubusercontent.com/tpope/vim-pathogen/master/autoload/pathogen.vim
}

# Write zsh completions for a tool. Tools that are not installed are skipped.
install_completion() {
	if ! command -v "$1" >/dev/null; then
		info "$1 not installed, skipping its completions"
		return 0
	fi
	mkdir -p "$HOME/.zsh/completions" &&
		"$1" completion zsh >"$HOME/.zsh/completions/_$1"
}

# Make ~/.zshrc load the repo defaults on its first line, before any existing
# content. zsh runs top to bottom, so the existing settings win any conflict.
setup_zshrc() {
	local zshrc="$HOME/.zshrc" new
	local load_defaults='source ~/.zshrc.dotfiles  # dotfiles defaults. Everything below overrides them.'

	copy_file .zshrc "$HOME/.zshrc.dotfiles" || return 1
	touch "$zshrc" || return 1
	if grep -qxF "$load_defaults" "$zshrc"; then
		info ".zshrc already loads the dotfiles defaults"
		return 0
	fi

	if [[ -s "$zshrc" ]]; then
		backup "$zshrc" || return 1
	fi
	new="$(mktemp)" &&
		{ echo "$load_defaults"; cat "$zshrc"; } >"$new" &&
		cat "$new" >"$zshrc" &&
		rm -f "$new"
}

# Agent instructions: Copilot CLI, Codex and Claude Code read these in every session.
step "Copilot CLI instructions" copy_file AGENTS.md "$HOME/.copilot/copilot-instructions.md"
step "Codex instructions" copy_file AGENTS.md "$HOME/.codex/AGENTS.md"
step "Claude Code instructions" copy_file AGENTS.md "$HOME/.claude/CLAUDE.md"

# Packages
step "Install Homebrew" install_homebrew
for package in fzf bat tree jq mycli helm zoxide gh eza goenv copilot-cli; do
	step "Install $package" brew_install "$package"
done
step "Configure fzf" configure_fzf

# Tools
step "Install lnav" sudo install -m 755 tools/lnav /usr/local/bin/lnav
step "Install datefmt" sudo install -m 755 tools/date /usr/local/bin/datefmt
step "Link start_ssh_agent" sudo ln -sf "$DOTFILES/start_ssh_agent.sh" /usr/local/bin/start_ssh_agent

# Vim, tmux and Git
step "Install vim pathogen" install_pathogen
step "Install vim apprentice theme" clone https://github.com/romainl/Apprentice.git "$HOME/.vim/bundle/apprentice"
step "Copy .vimrc" copy_file .vimrc "$HOME/.vimrc"
step "Copy .tmux.conf" copy_file .tmux.conf "$HOME/.tmux.conf"
step "Install tmux plugin manager" clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
step "Copy .gitconfig" copy_file .gitconfig "$HOME/.gitconfig"

# zsh
step "Install zsh" install_zsh
step "Install Oh My Zsh" clone https://github.com/ohmyzsh/ohmyzsh.git "$HOME/.oh-my-zsh"
step "Install zsh-autosuggestions" clone https://github.com/zsh-users/zsh-autosuggestions "$HOME/.oh-my-zsh/custom/plugins/zsh-autosuggestions"
step "Install powerlevel10k" clone https://github.com/romkatv/powerlevel10k.git "$HOME/powerlevel10k"
step "Copy .p10k.zsh" copy_file .p10k.zsh "$HOME/.p10k.zsh"
step "Install kubectl completions" install_completion kubectl
step "Install helm completions" install_completion helm
step "Set up ~/.zshrc" setup_zshrc

if [[ ${#failed_steps[@]} -gt 0 ]]; then
	error "Finished with ${#failed_steps[@]} failed step(s):"
	printf '  - %s\n' "${failed_steps[@]}" >&2
	exit 1
fi
info "Finished successfully"
